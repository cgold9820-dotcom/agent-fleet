{
  "name": "agent-fleet",
  "version": "0.1.0",
  "description": "Observability sidecar for parallel coding agents: per-task token & cost accounting across Claude Code and Codex, mapped to git worktrees (Orca-friendly), with daily reports.",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test dist/test/fleet.test.js",
    "start": "node dist/src/cli.js"
  },
  "keywords": [
    "ai-agents",
    "claude-code",
    "codex",
    "orca",
    "llm-observability",
    "token-usage",
    "git-worktree"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3"
  },
  "type": "module",
  "bin": {
    "agent-fleet": "dist/src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/src"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "marked": "^18.1.2",
    "nodemailer": "^10.3.1",
    "zod": "^4.6.7"
  }
}
